{
  "name": "sheetbot",
  "version": "1.0.0",
  "description": "Task Management and Automation System",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite --experimental-strip-types main.ts",
    "dev": "node --experimental-sqlite --experimental-strip-types --watch main.ts",
    "adduser": "node --experimental-sqlite --experimental-strip-types adduser.ts",
    "addapikey": "node --experimental-sqlite --experimental-strip-types addapikey.ts",
    "set-sheet-public": "node --experimental-sqlite --experimental-strip-types set-sheet-public.ts",
    "typecheck": "tsc --noEmit",
    "docs:build": "mdbook build",
    "docs:serve": "mdbook serve --open"
  },
  "dependencies": {
    "express": "4.18.3",
    "express-openapi-validator": "5.6.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "ajv": "8.17.1",
    "bcryptjs": "^2.4.3",
    "prompt-sync": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/prompt-sync": "^4.2.3"
  }
}
